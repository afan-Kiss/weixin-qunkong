# WXQK server environment example — do not put production secrets here.

# --- Core ---
WXQK_PORT=4812
WXQK_BIND=127.0.0.1
WXQK_DATA=/opt/wxqk/data
WXQK_PRODUCTION=0
# Required in production (https, non-placeholder host)
WXQK_PUBLIC_BASE_URL=https://your.production.host:8443/wxqk
# Alias still accepted:
# FACAI888_PUBLIC_BASE_URL=

# Device enrollment (default OFF in production)
WXQK_DEVICE_AUTO_ACTIVATE=0
# FACAI888_AUTO_ACTIVATE_DEVICES=0
# Optional invite for auto-activate of PENDING devices:
# WXQK_DEVICE_INVITE=

# Publish signing private seed (32-byte Ed25519) — NEVER commit real values.
# FACAI888_PUBLISH_KEY_B64=
# WXQK_PUBLISH_KEY_B64=
# Active signing key id (transition: facai888-v1 → wxqk-v2)
# WXQK_PUBLISH_SIGNING_KEY_ID=facai888-v1
# Client old-signer retirement ceiling (set after transition release):
# WXQK_OLD_SIGNER_MAX_SEQ=
# WXQK_NEW_SIGNER_MIN_SEQ=

# Authenticode (production only; leave empty → BLOCKED_EXTERNAL)
# WXQK_REQUIRE_AUTHENTICODE=0
# WXQK_AUTHENTICODE_THUMBPRINT=
# WXQK_SIGNTOOL_PATH=

# --- MeshCentral (optional subsystem; wxqk starts even if Mesh is down) ---
WXQK_MESH_ENABLED=0
WXQK_MESH_URL=https://mesh.example.invalid
WXQK_MESH_INTERNAL_URL=http://127.0.0.1:80
WXQK_MESH_USER=user//ops
# Hex loginTokenKey from: node node_modules/meshcentral --loginTokenKey
WXQK_MESH_LOGIN_KEY=
# Alias of WXQK_MESH_LOGIN_KEY
WXQK_MESH_SECRET=
# Login cookie lifetime in minutes (MeshCentral encodeCookie `expire`). Default 30.
WXQK_MESH_TOKEN_EXPIRE_MIN=30
WXQK_MESH_GROUP=
WXQK_MESH_TIMEOUT=15
# Comma-separated software usernames allowed to remote any device
WXQK_MESH_OPS_USERS=
# Optional custom CA path for lab/private Mesh TLS only.
# Production IP entry uses public Let's Encrypt IP certificates — leave unset.
# WXQK_MESH_TLS_CA=

# --- Deploy SSH (no AutoAddPolicy) ---
# WXQK_SSH_HOST=
# WXQK_SSH_USER=root
# WXQK_SSH_PASSWORD=
# WXQK_SSH_KNOWN_HOSTS=/path/to/known_hosts
# WXQK_SSH_HOST_KEY_SHA256=
