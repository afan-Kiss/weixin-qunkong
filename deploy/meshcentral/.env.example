# Copy to .env and fill locally. Do NOT commit real secrets or production hosts.
# Keep MESHCENTRAL_VERSION in sync with deploy/meshcentral/VERSION
MESHCENTRAL_VERSION=1.2.4
TZ=Asia/Shanghai

# MeshCentral public HTTPS base (no trailing slash)
WXQK_MESH_URL=https://mesh.example.invalid

# Optional internal URL for server-side health / sync
WXQK_MESH_INTERNAL_URL=http://127.0.0.1:80

# Docker / compose helpers
WXQK_MESH_HOSTNAME=mesh.example.invalid
WXQK_MESH_HTTPS_PORT=443
WXQK_MESH_HTTP_PORT=80
WXQK_MESH_AGENT_PORT=4433
WXQK_MESH_REVERSE_PROXY=false
WXQK_MESH_REVERSE_PROXY_TLS_PORT=443

# WXQK server adapter (usually set on the wxqk host)
WXQK_MESH_ENABLED=false
WXQK_MESH_USER=user//admin
# Hex loginTokenKey from MeshCentral (`node meshcentral --loginTokenKey`). Alias: WXQK_MESH_SECRET
WXQK_MESH_LOGIN_KEY=
WXQK_MESH_SECRET=
# Login cookie lifetime in minutes (MeshCentral encodeCookie `expire` field). Default 30.
WXQK_MESH_TOKEN_EXPIRE_MIN=30
WXQK_MESH_GROUP=
WXQK_MESH_TIMEOUT=15
WXQK_MESH_OPS_USERS=

# Agent download (admin-ui/scripts/fetch-mesh-agent.cjs)
# WXQK_MESH_AGENT_URL=https://mesh.example.invalid/meshagents?id=4
# WXQK_MESH_MSH_URL=
